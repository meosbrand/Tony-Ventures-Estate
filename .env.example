# Database (PostgreSQL connection string)
DATABASE_URL=postgresql://user:password@localhost:5432/tonymulti

# Session secret (use a long random string)
SESSION_SECRET=your-session-secret-here

# Server port
PORT=5000

# AI Provider: "openai" or "gemini"
AI_PROVIDER=openai

# OpenAI (required when AI_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Gemini (required when AI_PROVIDER=gemini)
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-1.5-flash

# Supabase (for image storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=property-images
